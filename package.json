{
  "name": "travel-apps-mcp",
  "type": "module",
  "version": "0.1.0",
  "description": "TypeScript MCP app for persisted travel planning workspaces",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "mcp-use dev",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "mcp-use build",
    "start": "mcp-use start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "inspector": "mcp-inspect --url http://localhost:3000/mcp",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "mcp-use generate-types || exit 0"
  },
  "dependencies": {
    "@mcp-use/cli": "3.1.2",
    "@mcp-use/inspector": "4.0.0",
    "mcp-use": "1.26.0",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "storybook": "^10.3.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.4"
  }
}
